  "schemas": {
   "ListRunsQuery": {
    "type": "object",
    "description": "Query for listing filing runs.",
    "properties": {
     "status": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "ObligationResponse": {
    "type": "object",
    "description": "A filing obligation as returned by the obligation reads.",
    "required": [
     "id",
     "template_id",
     "period",
     "next_due",
     "status"
    ],
    "properties": {
     "id": {
      "type": "string",
