     },
     "next_due": {
      "type": "string",
      "format": "date-time"
     },
     "period": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "template_id": {
      "type": "string",
      "format": "uuid"
     }
    }
   },
   "ProxyBackRequest": {
    "type": "object",
    "description": "Request body for the Flow proxy-back `POST /v1/internal/steps/execute`.",
    "required": [
     "step_kind",
     "workflow_id",
     "step_name",
     "input",
     "user_data"
    ],
    "properties": {
     "input": {},
     "step_config": {},
     "step_kind": {
      "type": "string"
     },
     "step_name": {
      "type": "string"
     },
     "user_data": {},
