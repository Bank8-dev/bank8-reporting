       "null"
      ]
     },
     "next_step": {
      "type": [
       "string",
       "null"
      ]
     },
     "output": {},
     "status": {
      "type": "string"
     }
    }
   },
   "RunResponse": {
    "type": "object",
    "description": "A filing run as returned by the run reads.",
    "required": [
     "id",
     "obligation_id",
     "period",
     "status"
    ],
    "properties": {
     "artifact_ref": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "type": "string",
      "format": "uuid"
     },
     "obligation_id": {
      "type": "string",
      "format": "uuid"
     },
     "period": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    }
   }
  }
 },
